# ------------------------------------------------------------
# Provider selection (required)
# Supported values: anthropic, bedrock, openai
# ------------------------------------------------------------
AI_PROVIDER="anthropic"

# ------------------------------------------------------------
# Anthropic configuration (used when AI_PROVIDER="anthropic")
# ------------------------------------------------------------
ANTHROPIC_API_KEY="anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet..."

# ------------------------------------------------------------
# AWS Bedrock configuration (used when AI_PROVIDER="bedrock")
# ------------------------------------------------------------
BEDROCK_MODEL="anthropic.claude-3-5-sonnet-20241022-v2:0"
AWS_REGION="eu-west-2"

# ------------------------------------------------------------
# OpenAI-compatible configuration (used when AI_PROVIDER="openai")
# ------------------------------------------------------------
OPENAI_API_KEY="openai-api-key"
OPENAI_MODEL="gpt..."
# Optional: defaults to https://api.openai.com/v1
OPENAI_BASE_URL="https://api.openai.com/v1"

# Bedrock credentials are resolved via the AWS SDK credential chain.
# e.g.
# Environment variables:
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_SESSION_TOKEN="..." # optional
#
# Named profile:
# AWS_PROFILE="your-profile"
#
# IAM role creds
